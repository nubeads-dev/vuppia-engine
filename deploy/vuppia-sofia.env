# Configuración del runner autónomo. Copiar a /etc/vuppia-sofia.env y editar.
# Las claves son SECRETOS del host: este archivo debe ser chmod 600 y propiedad de root/vuppia.
# NUNCA poner estas claves en el chat ni en archivos del sitio web.

# Imagen del sandbox fijada por digest (obligatorio para ejecutar codigo no confiable).
# Obtener con: docker image inspect vuppia-sandbox:3 --format '{{.Id}}'
VUPPIA_SANDBOX_DIGEST=sha256:REEMPLAZAR_POR_EL_DIGEST_REAL

# Base de datos del worker.
VUPPIA_DB=/opt/vuppia/worker/data/vuppia.sqlite3

# Intervalo entre ticks del loop (segundos).
VUPPIA_INTERVAL=900

# ---- IA (OPCIONAL). Sin esto, el runner corre SOLO trabajo gratis (experimentos en
# sandbox, observacion de memoria, integridad). Con esto, ademas investiga y evoluciona
# codigo con IA, SIEMPRE dentro del presupuesto. ----
# ANTHROPIC_API_KEY=...
# VUPPIA_PROPOSER=anthropic:claude-sonnet-5-5
# VUPPIA_SUBJECT=anthropic:claude-haiku-5-5
# VUPPIA_REVIEWER=anthropic:claude-haiku-5-5
# VUPPIA_RESEARCHER=anthropic:claude-sonnet-5-5
# VUPPIA_VERIFIER=anthropic:claude-haiku-5-5

# Topes de gasto (red de seguridad local; fijar TAMBIEN el tope en la consola del proveedor).
VUPPIA_DAILY_BUDGET_USD=1.00
VUPPIA_MONTHLY_BUDGET_USD=10.00
VUPPIA_PER_CALL_CAP_USD=0.25

# Clave PUBLICA de aprobacion (para que el worker pueda VERIFICAR promociones a produccion).
# La privada NO va aca: vive offline, el operador firma a mano. El runner NUNCA promueve a produccion.
# VUPPIA_APPROVAL_PUBKEY=...
